{
  "name": "smart-crawler",
  "version": "3.0.0",
  "description": "URL in. Clean markdown and structured JSON out.",
  "type": "module",
  "main": "./dist/client.js",
  "types": "./dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "bin": {
    "smartcrawl": "./dist/cli.js"
  },
  "files": [
    "dist",
    "openapi.yaml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "start": "node dist/server.js",
    "start:server": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json && npm --prefix ui run build"
  },
  "keywords": ["scrape", "markdown", "crawler", "playwright"],
  "license": "ISC",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "body-parser": "^2.2.1",
    "commander": "^14.0.2",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "fs-extra": "^11.3.2",
    "jsdom": "^29.1.1",
    "playwright": "^1.57.0",
    "robots-parser": "^3.0.1",
    "turndown": "^7.2.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5",
    "@types/fs-extra": "^11.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.1",
    "@types/turndown": "^5.0.6",
    "@types/uuid": "^10.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
